# LocalProof API Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database (Railway will provide DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/localproof

# JWT Secret (generate a random string - at least 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiry
JWT_EXPIRES_IN=7d

# Geo Settings
MAX_CHECKIN_DISTANCE_METERS=150

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
